# Shared, non-sensitive defaults. This file is committed.
# Secrets and personal overrides go in .env.local (git-ignored).
# Real environment variables override both files.

# Log verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL.
RAGNOSIS_LOG_LEVEL=INFO

# Where fetched articles and derived data are stored (git-ignored).
RAGNOSIS_DATA_DIR=data

# The list of Wikipedia titles that makes up the corpus.
RAGNOSIS_TOPICS_FILE=topics/pirates-and-antiquity-europe.txt

# Wikipedia language edition, e.g. en or sv. Titles in the topics file must match it.
RAGNOSIS_WIKI_LANGUAGE=en

# Model that turns text into vectors. Changing it requires `index --rebuild`.
RAGNOSIS_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Where Ollama runs, and the model that writes answers (download it with `ollama pull`).
RAGNOSIS_OLLAMA_URL=http://localhost:11434
RAGNOSIS_LLM_MODEL=qwen3.5:4b

# How long Ollama keeps the model in memory after an answer (e.g. 30m, 1h; -1 = always).
# Reloading it takes about 9 seconds, so longer means fewer slow first answers.
RAGNOSIS_LLM_KEEP_ALIVE=30m
